# Default: relative path for same-host / ALB path-based routing.
# VITE_API_BASE_URL=/api/v1

# Optional: absolute URL when running frontend and backend on separate origins.
# VITE_API_BASE_URL=http://localhost:8060/api/v1

# Vite dev server proxies /api to this target when using the relative path above.
# VITE_DEV_API_PROXY_TARGET=http://localhost:8060
